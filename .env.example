# --- База данных (database.py) ---
# Обязательная, значения по умолчанию в коде нет
DATABASE_URL=postgresql://user:password@db:5432/dbname
# или PostgreSQL:
# DATABASE_URL=postgresql://user:password@db:5432/dbname

# --- LLM (llm.py) ---
# Обязательная
LLM_API_KEY=your_groq_api_key_here
# Ниже значения по умолчанию из кода, можно не менять
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=4000
LLM_JSON_MAX_OUTPUT_TOKENS=12000
LLM_MAX_HISTORY=20

# --- Безопасность (security.py, main.py) ---
# Длинная случайная строка
JWT_SECRET=change_me_to_a_long_random_string
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# --- CORS (main.py) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173